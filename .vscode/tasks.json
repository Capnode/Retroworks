{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/Retroworks.RCBus/Retroworks.RCBus.csproj"
			], 
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-dmg-arm64",
			"type": "shell",
			"command": "${workspaceFolder}/Retroworks.RCBus.MacOS/build-dmg.sh",
			"args": ["arm64"],
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}/Retroworks.RCBus.MacOS"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"dependsOn": "build"
		},
		{
			"label": "build-dmg-x64",
			"type": "shell",
			"command": "${workspaceFolder}/Retroworks.RCBus.MacOS/build-dmg.sh",
			"args": ["x64"],
			"group": "build",
			"options": {
				"cwd": "${workspaceFolder}/Retroworks.RCBus.MacOS"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"dependsOn": "build"
		},
		{
			"label": "build-dmg",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build-dmg-arm64",
				"build-dmg-x64"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			}
		}
	]
}